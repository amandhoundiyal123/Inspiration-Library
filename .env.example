# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=designvault-local-jwt-secret-replace-in-production

# Gemini API Key (handled automatically by environment or set here)
GEMINI_API_KEY=

# Storage Directory (default is ./data/uploads)
STORAGE_DIR=./data/uploads

# Optional Supabase Configuration (if integrating external Supabase)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# DATABASE_URL=
